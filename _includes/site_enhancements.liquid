{% comment %}Shared visual system and bilingual navigation for the three primary pages.{% endcomment %}

<style>
  html:not([data-lang="zh"]) .lang-zh,
  html[data-lang="zh"] .lang-en { display: none !important; }
  :root {
    --global-theme-color: #3f7191 !important;
    --global-hover-color: #285873 !important;
    --global-text-color-light: #62717c !important;
    --site-surface: #f5f9fc;
    --site-border: #d7e3ec;
    --site-accent-soft: #e8f1f7;
    --site-accent-strong: #78a4bf;
    --site-radius: 14px;
  }
  html[data-theme="dark"] {
    --global-theme-color: #8fc1df !important;
    --global-hover-color: #b6d9ed !important;
    --global-text-color-light: #aebec9 !important;
    --site-surface: #1b2a34;
    --site-border: #334955;
    --site-accent-soft: #233945;
    --site-accent-strong: #6ca3c1;
  }
  body {
    background-image: linear-gradient(180deg, color-mix(in srgb, var(--site-accent-soft) 62%, transparent), transparent 30rem);
    background-repeat: no-repeat;
    font-family:
      Inter,
      "SF Pro Text",
      ui-sans-serif,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      "PingFang SC",
      "Microsoft YaHei",
      "Noto Sans CJK SC",
      "Source Han Sans SC",
      sans-serif;
    font-size: 1rem;
    line-height: 1.65;
    letter-spacing: -0.006em;
  }
  body h1,
  body h2,
  body h3,
  body h4 {
    font-family: inherit;
    letter-spacing: -0.035em;
  }
  html[data-lang="zh"] body h1,
  html[data-lang="zh"] body h2,
  html[data-lang="zh"] body h3,
  html[data-lang="zh"] body h4 {
    letter-spacing: 0.045em;
  }
  body h1 { font-weight: 720; }
  body h2,
  body h3 { font-weight: 680; }
  a { text-underline-offset: 0.18em; }
  .container { max-width: 1080px; }
  .post-header { margin-bottom: 2rem; }
  .post-header .post-title {
    margin-bottom: 0.35rem;
    font-size: clamp(2.35rem, 5vw, 3.8rem);
    line-height: 1.04;
  }
  .post-header .desc {
    max-width: 54rem;
    color: var(--global-text-color-light);
    font-size: 1.04rem;
  }
  :focus-visible {
    outline: 3px solid color-mix(in srgb, var(--global-theme-color) 38%, transparent);
    outline-offset: 3px;
  }

  .navbar {
    min-height: 62px;
    border-bottom-color: var(--site-border);
    background: color-mix(in srgb, var(--global-bg-color) 94%, transparent);
    backdrop-filter: blur(14px);
  }
  body.fixed-top-nav { padding-top: 68px; }
  .navbar .container { gap: 1rem; }
  .navbar .site-brand,
  .navbar .navbar-brand {
    margin-right: auto;
    font-size: 1rem;
    font-weight: 720;
    letter-spacing: -0.02em;
  }
  /* The theme sets font-size 1.7rem here, which makes the icon row taller than the
     nav links and stretches the navbar on the about page only. Match its specificity
     and drive the row height from the links instead of the glyph line box. */
  .navbar.navbar-light .navbar-brand.social {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0 auto 0 0;
    padding: 0;
    font-size: 1.15rem;
    line-height: 1;
  }
  .navbar.navbar-light .navbar-brand.social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1.5rem;
    line-height: 1;
    color: var(--global-text-color-light);
    transition: color 0.15s ease;
  }
  .navbar.navbar-light .navbar-brand.social a i,
  .navbar.navbar-light .navbar-brand.social a i::before {
    line-height: 1;
    vertical-align: middle;
  }
  .navbar.navbar-light .navbar-brand.social a:hover,
  .navbar.navbar-light .navbar-brand.social a:hover i::before {
    color: var(--global-theme-color);
  }
  .navbar .navbar-nav { align-items: center; gap: 0.15rem; }
  .navbar.navbar-light .navbar-nav .nav-item .nav-link {
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    font-size: 0.93rem;
    font-weight: 560;
  }
  html[data-lang="zh"] .navbar .site-brand,
  html[data-lang="zh"] .navbar .nav-link {
    letter-spacing: 0.025em;
  }
  .navbar.navbar-light .navbar-nav .nav-item.active > .nav-link {
    background: color-mix(in srgb, var(--global-theme-color) 10%, transparent);
  }
  #search-toggle { display: none; }

  .lang-switch:not([data-mounted="true"]) { visibility: hidden; }
  .lang-switch-item { display: flex; align-items: center; }
  .lang-switch {
    position: static;
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--site-border);
    border-radius: 999px;
    background: var(--site-surface);
    box-shadow: none;
  }
  .lang-switch button {
    min-width: 2.5rem;
    padding: 0.4rem 0.62rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 650;
  }
  .lang-switch button.active {
    background: var(--global-theme-color);
    color: #fff;
  }

  .profile {
    width: 190px !important;
    max-width: 190px !important;
    margin-top: -7.8rem !important;
    margin-left: 2.4rem !important;
  }
  .profile figure {
    width: 100%;
    margin: 0 0 0.85rem;
  }
  .profile img {
    border: 1px solid var(--site-border);
    border-radius: var(--site-radius) !important;
    box-shadow: 0 18px 44px rgba(47, 91, 118, 0.15);
  }
  .profile .more-info {
    width: 100%;
    margin: 0;
    font-family: inherit;
    color: var(--global-text-color-light);
    font-size: 0.84rem;
    line-height: 1.55;
    text-align: left;
    overflow-wrap: anywhere;
  }
  .profile .more-info p {
    display: block;
    margin: 0.15rem 0;
  }
  .home-intro {
    max-width: 47rem;
  }
  .home-intro .home-eyebrow {
    margin: 0 0 0.75rem;
    color: var(--global-theme-color);
    font-size: 0.76rem;
    font-weight: 760;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .home-intro > p:not(.home-eyebrow) {
    margin-bottom: 1rem;
  }
  .home-section {
    clear: both;
    margin-top: 3.5rem !important;
    padding-top: 0.15rem;
  }
  .home-section h3 {
    margin: 0 0 0.8rem !important;
    padding: 0.68rem 0.9rem !important;
    border-bottom: 0 !important;
    border-left: 4px solid var(--global-theme-color);
    background: linear-gradient(90deg, var(--site-accent-soft), transparent 88%);
    color: color-mix(in srgb, var(--global-theme-color) 88%, var(--global-text-color));
    font-size: 1.32rem !important;
  }
  .edu-item,
  .pub-item {
    padding: 0.95rem 0.4rem 0.95rem 1rem;
    margin: 0 !important;
    border-left: 1px solid var(--site-border);
    border-bottom: 1px solid var(--site-border);
  }
  .edu-item .edu-degree { font-weight: 650; }
  .edu-item .edu-meta {
    margin-top: 0.15rem;
    color: var(--global-text-color-light);
    font-size: 0.9rem;
  }
  .home-section > p {
    margin: 0 !important;
    padding: 0.7rem 0.4rem 0.7rem 1rem;
    border-left: 1px solid var(--site-border);
  }
  .edu-item:last-child,
  .pub-item:last-of-type { border-bottom: 0; }
  .home-section .pub-item > a {
    color: #244f69;
    font-weight: 650;
    line-height: 1.45;
  }
  .home-section .pub-item > a:hover { color: var(--global-hover-color); }
  .home-section .pub-venue {
    margin-top: 0.2rem;
    color: #61717c !important;
  }
  .social { margin-top: 2.5rem; }
  .social .contact-icons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    font-size: 1.45rem;
  }
  .social .contact-note {
    margin-top: 0.7rem;
    color: var(--global-text-color-light);
    font-size: 0.86rem;
  }

  .bibsearch-form-input {
    max-width: 30rem;
    padding: 0.72rem 0.9rem;
    border-color: var(--site-border);
    border-radius: 10px;
    background: var(--site-surface);
  }
  .publications { margin-top: 2.5rem; }
  .pub-group-title {
    margin: 3.2rem 0 0 !important;
    padding: 0 0 0.75rem !important;
    border-bottom: 1px solid var(--site-border) !important;
    font-size: 1.55rem;
  }
  .pub-group-note {
    margin: 0.65rem 0 1.6rem !important;
    color: var(--global-text-color-light) !important;
    font-size: 0.9rem !important;
  }
  .publications h2.bibliography {
    margin: 2.4rem 0 0 !important;
    padding: 0 0 0.55rem !important;
    border-top: 0 !important;
    border-bottom: 1px solid var(--site-border);
    color: var(--global-text-color-light) !important;
    font-size: 0.95rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-align: left !important;
  }
  .publications ol.bibliography { margin: 0 !important; }
  .publications ol.bibliography li {
    margin: 0 !important;
    padding: 1.65rem 0 !important;
    border-bottom: 1px solid var(--site-border);
  }
  .publications ol.bibliography li .row {
    display: grid;
    grid-template-columns: 144px minmax(0, 1fr);
    gap: 1.5rem;
    margin: 0;
  }
  .publications ol.bibliography li .col,
  .publications ol.bibliography li .col-sm-2,
  .publications ol.bibliography li .col-sm-8 {
    width: auto;
    max-width: none;
    padding: 0;
  }
  .publications ol.bibliography li .abbr {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .publications ol.bibliography li .abbr abbr {
    margin-bottom: 0.55rem;
    padding: 0.32rem 0.45rem;
    border-radius: 7px !important;
    background: color-mix(in srgb, var(--global-theme-color) 12%, transparent);
    color: var(--global-theme-color) !important;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.04em;
  }
  .publications ol.bibliography li .abbr figure { margin: 0; }
  .publications ol.bibliography li .preview {
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--site-border);
    border-radius: 10px !important;
    object-fit: cover;
    box-shadow: none;
  }
  .publications ol.bibliography li .title {
    margin-bottom: 0.35rem;
    font-size: 1.08rem;
    font-weight: 680;
    line-height: 1.38;
  }
  .publications ol.bibliography li .title a { color: var(--global-text-color); }
  .publications ol.bibliography li .author,
  .publications ol.bibliography li .periodical {
    color: var(--global-text-color-light);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .publications ol.bibliography li .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.8rem;
  }
  .publications ol.bibliography li .links a.btn {
    margin: 0 !important;
    padding: 0.34rem 0.72rem !important;
    border: 1px solid var(--site-border) !important;
    border-radius: 999px;
    background: var(--site-surface);
    color: var(--global-text-color) !important;
    font-size: 0.78rem;
    font-weight: 620;
  }
  .publications ol.bibliography li .links a.btn:hover {
    border-color: var(--global-theme-color) !important;
    color: var(--global-theme-color) !important;
    text-decoration: none;
  }
  .publications ol.bibliography li .abstract.hidden,
  .publications ol.bibliography li div.abstract.hidden {
    max-height: none !important;
    margin-top: 1rem !important;
    border: 0 !important;
    color: var(--global-text-color-light);
    font-size: 0.89rem !important;
    line-height: 1.62;
    text-align: left !important;
  }
  .publications ol.bibliography li .abstract.hidden p {
    margin: 0 !important;
    color: inherit;
    line-height: inherit !important;
  }

  .cv-nav {
    position: static;
    display: flex;
    flex-wrap: wrap !important;
    gap: 0.45rem 1.1rem !important;
    margin: 0 0 2.4rem !important;
    padding: 0 0 1rem !important;
    overflow: visible;
    border-bottom: 1px solid var(--site-border) !important;
    background: transparent;
  }
  .cv-nav a {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--global-theme-color);
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--global-theme-color) 32%, transparent);
    text-underline-offset: 0.22em;
  }
  .cv-nav a:hover {
    color: var(--global-hover-color);
    text-decoration-color: currentColor;
  }
  h2.cv-heading {
    margin: 3.4rem 0 1rem !important;
    padding: 0.72rem 1rem !important;
    border-bottom: 0 !important;
    border-left: 4px solid var(--global-theme-color);
    background: linear-gradient(90deg, var(--site-accent-soft), transparent 82%);
    color: var(--global-theme-color);
    font-size: 1.5rem !important;
  }
  .cv-section {
    margin: 0 0 3.2rem 0.25rem !important;
    padding-left: 1rem;
    border-left: 1px solid var(--site-border);
  }
  .cv-entry {
    padding: 0.9rem 0 !important;
    border-bottom-color: var(--site-border) !important;
  }
  .cv-entry-title { font-weight: 650 !important; }
  .cv-entry-sub,
  .cv-entry-date { color: var(--global-text-color-light) !important; }

  footer:not(.fixed-bottom) {
    margin-top: 5rem;
    border-top: 1px solid var(--site-border);
    background: var(--global-bg-color);
  }
  footer:not(.fixed-bottom) .container {
    padding-top: 1.4rem;
    padding-bottom: 1.4rem;
    color: var(--global-text-color-light);
    text-align: center;
  }

  @media (max-width: 767px) {
    .container { padding-right: 1.15rem; padding-left: 1.15rem; }
    .navbar .container { padding-right: 1rem; padding-left: 1rem; }
    .navbar .navbar-collapse-main { order: 4; flex-basis: 100%; }
    .navbar .navbar-menu-list { align-items: flex-start; gap: 0.35rem; padding: 0.7rem 0 0.9rem; }
    .lang-switch-item { margin-top: 0.2rem; }
    .post-header .post-title { font-size: 2.5rem; }
    .profile {
      float: none !important;
      width: min(48%, 190px) !important;
      margin: -0.75rem 0 1.6rem !important;
    }
    .publications ol.bibliography li .row {
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 1rem;
    }
    .publications ol.bibliography li .col-sm-8 { display: contents; }
    .publications ol.bibliography li .abbr { grid-column: 1; grid-row: 1 / 6; }
    .publications ol.bibliography li .title,
    .publications ol.bibliography li .author,
    .publications ol.bibliography li .periodical,
    .publications ol.bibliography li .links { grid-column: 2; }
    .publications ol.bibliography li .title { font-size: 1rem; }
    .publications ol.bibliography li .abstract.hidden,
    .publications ol.bibliography li div.abstract.hidden {
      grid-column: 1 / -1;
      font-size: 0.86rem !important;
    }
  }
</style>

<script>
  (function () {
    var copy = {
      en: {
        name: "Yongxue Chen",
        about: "About",
        homeDescription: "PhD Candidate in Production and Manufacturing Engineering · The University of Manchester",
        publications: "Publications",
        cv: "CV",
        publicationsDescription: "Peer-reviewed journal articles, grouped by authorship and listed in reverse chronological order.",
        cvDescription: "Education, publications, patents, teaching, awards, and research experience.",
        footer: "© 2026 Yongxue Chen · Built with Jekyll · Hosted on GitHub Pages",
      },
      zh: {
        name: "陈永学",
        about: "关于我",
        homeDescription: "生产与制造工程博士研究生 · 英国曼彻斯特大学",
        publications: "论文",
        cv: "简历",
        publicationsDescription: "同行评审期刊论文，按作者身份分组并以时间倒序排列。",
        cvDescription: "教育背景、论文、专利、教学、荣誉与科研经历。",
        footer: "© 2026 陈永学 · 使用 Jekyll 构建 · 托管于 GitHub Pages",
      },
    };

    function currentLang() {
      return document.documentElement.getAttribute("data-lang") === "zh" ? "zh" : "en";
    }

    function updateInterface(lang) {
      var labels = copy[lang];
      document.documentElement.lang = lang === "zh" ? "zh-CN" : "en";
      document.querySelectorAll(".navbar a.nav-link").forEach(function (link) {
        var path = new URL(link.href, window.location.origin).pathname;
        if (path === "/") link.childNodes[0].nodeValue = labels.about + " ";
        if (path === "/publications/") link.childNodes[0].nodeValue = labels.publications + " ";
        if (path === "/cv/") link.childNodes[0].nodeValue = labels.cv + " ";
      });

      var path = window.location.pathname;
      var brand = document.querySelector(".site-brand");
      var heading = document.querySelector(".post-header .post-title");
      var description = document.querySelector(".post-header .desc");
      if (brand) brand.textContent = labels.name;
      if (path === "\/") {
        if (heading) heading.textContent = labels.name;
        if (description) description.textContent = labels.homeDescription;
        document.title = labels.name;
      } else if (path === "\/publications\/") {
        if (heading) heading.textContent = labels.publications;
        if (description) description.textContent = labels.publicationsDescription;
        document.title = labels.publications + " | " + labels.name;
      } else if (path === "/cv/") {
        if (heading) heading.textContent = labels.cv;
        if (description) description.textContent = labels.cvDescription;
        document.title = labels.cv + " | " + labels.name;
      }

      var footer = document.querySelector("footer .container");
      if (footer) footer.textContent = labels.footer;
      var en = document.getElementById("lang-btn-en");
      var zh = document.getElementById("lang-btn-zh");
      if (en && zh) {
        en.setAttribute("aria-pressed", String(lang === "en"));
        zh.setAttribute("aria-pressed", String(lang === "zh"));
      }
    }

    function mountChrome() {
      var navbar = document.querySelector(".navbar .container");
      if (navbar && !navbar.querySelector(".site-brand")) {
        var existing = navbar.querySelector(".navbar-brand");
        if (!existing) {
          var brand = document.createElement("a");
          brand.className = "navbar-brand site-brand";
          brand.href = "/";
          brand.textContent = "Yongxue Chen";
          navbar.insertBefore(brand, navbar.firstChild);
        } else if (!existing.classList.contains("social")) {
          // The social variant holds icon links; tagging it as .site-brand would let
          // applyLabels() overwrite its children with the plain-text name.
          existing.classList.add("site-brand");
        }
      }

      var switcher = document.querySelector(".lang-switch");
      var menu = document.querySelector(".navbar-menu-list");
      if (switcher && menu && !menu.querySelector(".lang-switch")) {
        var item = document.createElement("li");
        item.className = "nav-item lang-switch-item";
        menu.appendChild(item);
        item.appendChild(switcher);
        switcher.setAttribute("data-mounted", "true");
      }

      document.querySelectorAll(".publications img.preview").forEach(function (image) {
        var item = image.closest("li");
        var title = item && item.querySelector(".title");
        image.loading = "lazy";
        image.removeAttribute("data-zoomable");
        if (title) image.alt = "Preview for " + title.textContent.trim();
      });
    }

    function initEnhancements() {
      mountChrome();
      var original = window.setSiteLang;
      window.setSiteLang = function (lang) {
        if (original) original(lang);
        updateInterface(lang);
      };
      updateInterface(currentLang());
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initEnhancements);
    } else {
      initEnhancements();
    }
  })();
</script>
