@article{dutta2026implicit,
  preview   = {CADProcPlanDirectCtrl.jpg},
  html      = {https://doi.org/10.1016/j.cad.2026.104086},
  website   = {https://neelotpal-d.github.io/Implicit_MultiAxis/},
  arxiv     = {2511.17578},
  video     = {https://youtu.be/9nTCbEfrANk},
  author_type = {co},
  title     = {Implicit Neural Field-Based Process Planning for Multi-Axis Manufacturing: Direct Control over Collision Avoidance and Toolpath Geometry},
  author    = {Dutta, Neelotpal and Zhang, Tianyu and Liu, Tao and Chen, Yongxue and Wang, Charlie C. L.},
  journal   = {Computer-Aided Design},
  year      = {2026},
  url       = {https://www.sciencedirect.com/science/article/pii/S0010448526000564},
  abstract  = {Existing curved-layer-based process planning methods for multi-axis manufacturing address collisions only indirectly and generate toolpaths in a post-processing step, leaving toolpath geometry uncontrolled during optimization. This paper presents an implicit neural field-based framework for multi-axis process planning that overcomes these limitations by embedding both layer generation and toolpath design within a single differentiable pipeline. Using sinusoidally activated neural networks to represent layers and toolpaths as implicit fields, the method enables direct evaluation of field values and derivatives at any spatial point, thereby allowing explicit collision avoidance and joint optimization of manufacturing layers and toolpaths. The authors further investigate how network hyperparameters and objective definitions influence singularity behavior and topology transitions, offering built-in mechanisms for regularization and stability control, and demonstrate the approach on examples in both additive and subtractive manufacturing.},
  abbr      = {CAD}
}

@article{huang2026force,
  preview   = {AMForceFeedbackFDM.jpg},
  html      = {https://doi.org/10.1016/j.rcim.2025.103123},
  website   = {https://github.com/yuminghuang1995/ForceBasedDeposition/},
  video     = {https://youtu.be/i_Gpd3_gRxA},
  author_type = {co},
  title     = {Force-Based Adaptive Deposition in Multi-Axis Additive Manufacturing: Low Porosity for Enhanced Strength},
  author    = {Huang, Yuming and Su, Renbo and Qian, Kun and Zhang, Tianyu and Chen, Yongxue and Liu, Tao and Fang, Guoxin and Wang, Weiming and Wang, Charlie C. L.},
  journal   = {Robotics and Computer-Integrated Manufacturing},
  year      = {2026},
  url       = {https://www.sciencedirect.com/science/article/pii/S0736584525001772},
  abstract  = {This paper presents a force-based adaptive deposition method for reducing porosity in filament-based multi-axis additive manufacturing. Porosity often arises in 3D printed structures with curved layers due to non-uniform layer thickness, unstable material extrusion, and significant curvature variations across different regions of a model. The closed-loop control approach dynamically adjusts the local material deposition rate by modulating the printer head motion in response to force feedback while maintaining a constant extrusion speed. Compared to purely geometry-based methods, the approach effectively reduces porosity, leading to a significant improvement in the mechanical strength of fabricated specimens, demonstrating up to 72.1% higher breaking force while maintaining comparable or even slightly reduced weights.},
  abbr      = {RCIM}
}

@article{liu2025neural,
  preview   = {SIG2025CoOptmFRComposite.jpg},
  html      = {https://doi.org/10.1145/3730922},
  website   = {https://ryantaoliu.github.io/NeuralTOMO/},
  arxiv     = {2505.03779},
  video     = {https://youtu.be/ooiX590cSkE},
  author_type = {co},
  title     = {Neural Co-Optimization of Structural Topology, Manufacturable Layers, and Path Orientations for Fiber-Reinforced Composites},
  author    = {Liu, Tao and Zhang, Tianyu and Chen, Yongxue and Wang, Weiming and Jiang, Yu and Huang, Yuming and Wang, Charlie C. L.},
  journal   = {ACM Transactions on Graphics},
  year      = {2025},
  url       = {https://dl.acm.org/doi/10.1145/3730922},
  abstract  = {We propose a neural network-based computational framework for the simultaneous optimization of structural topology, curved layers, and path orientations to achieve strong anisotropic strength in fiber-reinforced thermoplastic composites while ensuring manufacturability. Our framework employs three implicit neural fields to represent geometric shape, layer sequence, and fiber orientation. This enables the direct formulation of both design and manufacturability objectives, such as anisotropic strength, structural volume, machine motion control, layer curvature, and layer thickness, into an integrated and differentiable optimization process. Physical experiments demonstrate that the composites generated by our co-optimization method can achieve an improvement of up to 33.1% in failure loads compared to composites with sequentially optimized structures and manufacturing sequences.},
  abbr      = {TOG}
}

@article{zhang2025toolpath,
  preview   = {AMHighDenseToolpath.jpg},
  html      = {https://doi.org/10.1016/j.compositesb.2025.112154},
  arxiv     = {2410.16851},
  video     = {https://youtu.be/ylBgGtqyhDE},
  code      = {https://github.com/zhangty019/HighDensity_ToolpathGene4CFRTP},
  author_type = {co},
  title     = {Toolpath Generation for High Density Spatial Fiber Printing Guided by Principal Stresses},
  author    = {Zhang, Tianyu and Liu, Tao and Dutta, Neelotpal and Chen, Yongxue and Su, Renbo and Zhang, Zhizhou and Wang, Weiming and Wang, Charlie C. L.},
  journal   = {Composites Part B},
  year      = {2025},
  url       = {https://doi.org/10.1016/j.compositesb.2025.112154},
  abstract  = {While multi-axis 3D printing can align continuous fibers along principal stresses in continuous fiber-reinforced thermoplastic composites to enhance mechanical strength, existing methods have difficulty generating toolpaths with high fiber coverage. This is mainly due to the orientation consistency constraints imposed by vector-field-based methods and the turbulent stress fields around stress concentration regions. This paper addresses these challenges by introducing a 2-RoSy representation for computing the direction field, which is then converted into a periodic scalar field to generate partial iso-curves for fiber toolpaths with nearly equal hatching distance. The proposed method can achieve toolpath coverage between 87.5% and 90.6% by continuous fibers with 1.1 mm width. Specimens fabricated using these toolpaths show up to 84.6% improvement in failure load and 54.4% increase in stiffness compared to results obtained from multi-axis 3D printing with sparser fibers.},
  abbr      = {CompB}
}

@article{liu2024neural,
  preview   = {SIG2024NeuralSlicer.jpg},
  html      = {https://doi.org/10.1145/3658212},
  website   = {https://ryantaoliu.github.io/NeuralSlicer/},
  arxiv     = {2404.15061},
  video     = {https://youtu.be/LF1fRD7ygdE},
  code      = {https://github.com/RyanTaoLiu/NeuralSlicer},
  author_type = {co},
  title     = {Neural Slicer for Multi-Axis 3D Printing},
  author    = {Liu, Tao and Zhang, Tianyu and Chen, Yongxue and Huang, Yuming and Wang, Charlie C. L.},
  journal   = {ACM Transactions on Graphics},
  year      = {2024},
  url       = {https://doi.org/10.1145/3658212},
  abstract  = {This paper introduces a novel neural network-based computational pipeline as a representation-agnostic slicer for multi-axis 3D printing that can work on models with diverse representations and intricate topology. The approach involves employing neural networks to establish a deformation mapping, defining a scalar field in the space surrounding an input model, and isosurfaces are subsequently extracted from this field to generate curved layers for 3D printing. Creating a differentiable pipeline enables optimization of the mapping through loss functions directly defined on the field gradients as the local printing directions. New loss functions have been introduced to meet the manufacturing objectives of support-free and strength reinforcement.},
  abbr      = {TOG}
}

@article{ding2023point,
  preview   = {CADCutterEnvelope.jpg},
  html      = {https://doi.org/10.1016/j.cad.2023.103588},
  author_type = {co},
  title     = {Point Pair-Based Expression of Cutter Swept Envelopes in Five-Axis Milling},
  author    = {Ding, Ye and Chen, Yongxue},
  journal   = {Computer-Aided Design},
  year      = {2023},
  url       = {https://doi.org/10.1016/j.cad.2023.103588},
  abstract  = {This paper proposes an efficient method of formulating cutter swept envelopes in five-axis milling based on conformal geometric algebra. The surface of the rotary cutter is represented as a canal surface, as the envelope of a one-parameter family of spheres. The swept envelopes generated by the general rigid motion of the cutter can be regarded as a two-parameter family of spheres. With the help of the dual representations of spheres and planes in conformal space, a point pair-based expression of the swept envelopes is formulated analytically, which represents two surfaces uniformly. Using the present method, the swept surfaces of a conical cutter, a drum-shaped cutter, and a toroidal cutter are illustrated. As an application, two types of collision detection methods for 5-axis milling are presented based on the point pair-based envelope expression.},
  abbr      = {CAD}
}
